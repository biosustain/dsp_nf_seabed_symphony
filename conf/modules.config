//
// Per-process tool arguments and publishing rules.
//
// Selectors are fully qualified (`PREPROCESSING_QC:NANOPLOT`) because the same
// module is included twice under different aliases. Nextflow matches these as
// anchored regexes, so `...:NANOPLOT` does not also match `...:NANOPLOT_TRIMMED`.
//

process {

    // ── Step 1a: NanoPlot, raw reads ─────────────────────────────────────────
    withName: 'PREPROCESSING_QC:NANOPLOT' {
        ext.args   = '--plots dot --legacy dot --N50'
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/raw/${meta.id}" },
            mode: 'copy'
        ]
    }

    // ── Step 1b: SeqKit stats, raw reads ─────────────────────────────────────
    withName: 'PREPROCESSING_QC:SEQKIT_STATS' {
        ext.args   = '--all'
        ext.prefix = { "${meta.id}.raw" }
        publishDir = [
            path: { "${params.outdir}/qc/seqkit" },
            mode: 'copy'
        ]
    }

    // ── Step 2a: Filtlong, length filter ─────────────────────────────────────
    // Reads are an intermediate and are deliberately not published; the log is
    // kept because it records how many bases survived the filter.
    withName: 'PREPROCESSING_QC:FILTLONG_MINLEN' {
        ext.args   = '--min_length 1000'
        ext.prefix = { "${meta.id}.minlen" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/logs" },
            mode: 'copy',
            pattern: '*.log'
        ]
    }

    // ── Step 2b: Filtlong, quality filter ────────────────────────────────────
    withName: 'PREPROCESSING_QC:FILTLONG_QUALITY' {
        ext.args   = '--keep_percent 90'
        ext.prefix = { "${meta.id}.highquality" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/logs" },
            mode: 'copy',
            pattern: '*.log'
        ]
    }

    // ── Step 3: Porechop, adapter removal ────────────────────────────────────
    // These are the analysis-ready reads consumed by Workflow 2.
    withName: 'PREPROCESSING_QC:PORECHOP_PORECHOP' {
        ext.prefix = { "${meta.id}.clean" }
        publishDir = [
            [
                path: { "${params.outdir}/preprocessing/${meta.id}" },
                mode: 'copy',
                pattern: '*.fastq.gz'
            ],
            [
                path: { "${params.outdir}/preprocessing/logs" },
                mode: 'copy',
                pattern: '*.log'
            ]
        ]
    }

    // ── Step 4a: NanoPlot, trimmed reads ─────────────────────────────────────
    withName: 'PREPROCESSING_QC:NANOPLOT_TRIMMED' {
        ext.args   = '--plots dot --legacy dot --N50'
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/trimmed/${meta.id}" },
            mode: 'copy'
        ]
    }

    // ── Step 4b: SeqKit stats, trimmed reads ─────────────────────────────────
    withName: 'PREPROCESSING_QC:SEQKIT_STATS_TRIMMED' {
        ext.args   = '--all'
        ext.prefix = { "${meta.id}.trimmed" }
        publishDir = [
            path: { "${params.outdir}/qc/seqkit" },
            mode: 'copy'
        ]
    }

    // =========================================================================
    // Workflow 2 — Metagenome Assembly & Annotation
    // =========================================================================

    // ── Step 5: metaFlye ─────────────────────────────────────────────────────
    // The read-type flag (--nano-hq) is passed as a module input, not here.
    withName: 'ASSEMBLY_ANNOTATION:FLYE' {
        ext.args   = { "--meta --iterations ${params.flye_iterations}" }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/assembly/${meta.id}" },
            mode: 'copy'
        ]
    }

    // ── Step 6: Bandage assembly-graph image ─────────────────────────────────
    // Bandage is a Qt application; without an offscreen platform it tries to
    // open a display and fails on headless machines (i.e. any HPC node).
    withName: 'ASSEMBLY_ANNOTATION:BANDAGE_IMAGE' {
        ext.prefix   = { "${meta.id}.assembly_graph" }
        beforeScript = 'export QT_QPA_PLATFORM=offscreen'
        publishDir = [
            path: { "${params.outdir}/assembly/${meta.id}/graph" },
            mode: 'copy'
        ]
    }

    // ── Step 7: Whokaryote classification ────────────────────────────────────
    // --minsize defaults to 5000 in whokaryote: contigs shorter than this are
    // not classified at all. Lower it here if your assembly is fragmented.
    withName: 'ASSEMBLY_ANNOTATION:WHOKARYOTE' {
        publishDir = [
            path: { "${params.outdir}/taxonomy/whokaryote/${meta.id}" },
            mode: 'copy',
            // Outputs are emitted as whokaryote/<file>; strip that level so they
            // don't land in .../whokaryote/<sample>/whokaryote/
            saveAs: { filename -> filename.replaceFirst('^whokaryote/', '') }
        ]
    }

    // ── Step 8: split assembly by domain ─────────────────────────────────────
    // Prokaryotic contigs are the hand-off to Workflow 3.
    withName: 'ASSEMBLY_ANNOTATION:EXTRACT_PROKARYOTE' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/contigs/prokaryote" },
            mode: 'copy'
        ]
    }

    withName: 'ASSEMBLY_ANNOTATION:EXTRACT_EUKARYOTE' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/contigs/eukaryote" },
            mode: 'copy'
        ]
    }
}
