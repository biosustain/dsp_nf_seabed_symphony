//
// Per-process tool arguments and publishing rules.
//
// Selectors are fully qualified (`PREPROCESSING_QC:NANOPLOT`) because the same
// module is included twice under different aliases. Nextflow matches these as
// anchored regexes, so `...:NANOPLOT` does not also match `...:NANOPLOT_TRIMMED`.
//

process {

    // ── Step 1a: NanoPlot, raw reads ─────────────────────────────────────────
    withName: 'PREPROCESSING_QC:NANOPLOT' {
        ext.args   = '--plots dot --legacy dot --N50'
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/raw/${meta.id}" },
            mode: 'copy'
        ]
    }

    // ── Step 1b: SeqKit stats, raw reads ─────────────────────────────────────
    withName: 'PREPROCESSING_QC:SEQKIT_STATS' {
        ext.args   = '--all'
        ext.prefix = { "${meta.id}.raw" }
        publishDir = [
            path: { "${params.outdir}/qc/seqkit" },
            mode: 'copy'
        ]
    }

    // ── Step 2a: Filtlong, length filter ─────────────────────────────────────
    // Reads are an intermediate and are deliberately not published; the log is
    // kept because it records how many bases survived the filter.
    withName: 'PREPROCESSING_QC:FILTLONG_MINLEN' {
        ext.args   = '--min_length 1000'
        ext.prefix = { "${meta.id}.minlen" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/logs" },
            mode: 'copy',
            pattern: '*.log'
        ]
    }

    // ── Step 2b: Filtlong, quality filter ────────────────────────────────────
    withName: 'PREPROCESSING_QC:FILTLONG_QUALITY' {
        ext.args   = '--keep_percent 90'
        ext.prefix = { "${meta.id}.highquality" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/logs" },
            mode: 'copy',
            pattern: '*.log'
        ]
    }

    // ── Step 3: Porechop, adapter removal ────────────────────────────────────
    // These are the analysis-ready reads consumed by Module 2.
    withName: 'PREPROCESSING_QC:PORECHOP_PORECHOP' {
        ext.prefix = { "${meta.id}.clean" }
        publishDir = [
            [
                path: { "${params.outdir}/preprocessing/${meta.id}" },
                mode: 'copy',
                pattern: '*.fastq.gz'
            ],
            [
                path: { "${params.outdir}/preprocessing/logs" },
                mode: 'copy',
                pattern: '*.log'
            ]
        ]
    }

    // ── Step 4a: NanoPlot, trimmed reads ─────────────────────────────────────
    withName: 'PREPROCESSING_QC:NANOPLOT_TRIMMED' {
        ext.args   = '--plots dot --legacy dot --N50'
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/trimmed/${meta.id}" },
            mode: 'copy'
        ]
    }

    // ── Step 4b: SeqKit stats, trimmed reads ─────────────────────────────────
    withName: 'PREPROCESSING_QC:SEQKIT_STATS_TRIMMED' {
        ext.args   = '--all'
        ext.prefix = { "${meta.id}.trimmed" }
        publishDir = [
            path: { "${params.outdir}/qc/seqkit" },
            mode: 'copy'
        ]
    }
}
