// Module-specific parameters and publish directories
// Process selectors use the full workflow path for disambiguation when the
// same module is included under two aliases (e.g. NANOPLOT vs NANOPLOT_TRIMMED).

process {

    // ── NanoPlot (raw reads) ─────────────────────────────────────────────────
    withName: 'PREPROCESSING_QC:NANOPLOT' {
        ext.args = '--plots dot --legacy dot --N50'
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/raw/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── NanoPlot (trimmed reads) ─────────────────────────────────────────────
    withName: 'PREPROCESSING_QC:NANOPLOT_TRIMMED' {
        ext.args = '--plots dot --legacy dot --N50'
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/trimmed/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── SeqKit stats (raw reads) ─────────────────────────────────────────────
    withName: 'PREPROCESSING_QC:SEQKIT_STATS' {
        ext.prefix = { "${meta.id}.raw" }
        publishDir = [
            path: { "${params.outdir}/qc/seqkit/raw" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── SeqKit stats (trimmed reads) ─────────────────────────────────────────
    withName: 'PREPROCESSING_QC:SEQKIT_STATS_TRIMMED' {
        ext.prefix = { "${meta.id}.trimmed" }
        publishDir = [
            path: { "${params.outdir}/qc/seqkit/trimmed" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── Filtlong: length filter (pass 1) ─────────────────────────────────────
    withName: 'PREPROCESSING_QC:FILTLONG_MINLEN' {
        ext.args   = '--min_length 1000'
        ext.prefix = { "${meta.id}.minlen" }
        publishDir = [
            enabled: false  // intermediate file — not published
        ]
    }

    // ── Filtlong: quality filter (pass 2) ────────────────────────────────────
    withName: 'PREPROCESSING_QC:FILTLONG_QUALITY' {
        ext.args   = '--keep_percent 90'
        ext.prefix = { "${meta.id}.highquality" }
        publishDir = [
            enabled: false  // intermediate file — not published
        ]
    }

    // ── Porechop ─────────────────────────────────────────────────────────────
    withName: 'PREPROCESSING_QC:PORECHOP_PORECHOP' {
        ext.prefix = { "${meta.id}.clean" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/${meta.id}" },
            mode: 'copy',
            pattern: '*.fastq.gz',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
